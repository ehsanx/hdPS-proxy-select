# t-test for Age
age_no_dmd_mean <- 45.94
age_no_dmd_sd <- 13.74
age_any_dmd_mean <- 37.54
age_any_dmd_sd <- 9.93
# Assuming equal sample sizes (this is an example, adjust accordingly):
n_no_dmd <- 16073
n_any_dmd <- 3287
# t-test
t_test_result <- t.test(x = rnorm(n_no_dmd, mean = age_no_dmd_mean, sd = age_no_dmd_sd),
y = rnorm(n_any_dmd, mean = age_any_dmd_mean, sd = age_any_dmd_sd))
t_test_result$p.value
