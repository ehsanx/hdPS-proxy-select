create_rd_data <- function(methods, methods_name) {
RD_est <- data.frame()
for (i in seq_along(methods)) {
rd_name <- paste0("RD_", methods[i])
ci_name <- paste0("ci_", methods[i])
if (exists(rd_name) && exists(ci_name)) {
rd <- get(rd_name)
ci <- get(ci_name)
rd_ci <- c(rd, ci)
RD_est <- rbind(RD_est, rd_ci)
} else {
warning(paste("Data missing for method:", methods[i]))
}
}
if (nrow(RD_est) > 0) {
RD_est$method <- methods_name[1:nrow(RD_est)]  # Adjust names to match rows
colnames(RD_est) <- c("RD", "lower.ci", "upper.ci", "method")
} else {
stop("No valid data found for the given methods.")
}
return(RD_est)
}
