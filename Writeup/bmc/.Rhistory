methods_sub3 <- c("tmleS.ks", "hdpslassoslS", "lassoslS", "hdpsslS", "slS.ks", "ps.ks", "dctmleS")
methods_sub4 <- c("tmle.ks", "hdpslassosl", "lassosl", "hdpssl", "sl.ks", "ps.ks", "dctmle")
methods_name_no_sub <- c("hdPS.LASSO", "LASSO", "hdPS", "SL.ks", "PS.ks")
methods_name_sub3 <- c("TMLE.ks.3", "hdPS.LASSO.SL.3", "LASSO.SL.3", "hdPS.SL.3", "SL.ks.3", "PS.ks", "DC.TMLE.3")
methods_name_sub4 <- c("TMLE.ks.4", "hdPS.LASSO.SL.4", "LASSO.SL.4", "hdPS.SL.4", "SL.ks.4", "PS.ks", "DC.TMLE.4")
# Function to create RD data (no changes here)
create_rd_data <- function(methods, methods_name) {
RD_est <- data.frame()
for (i in seq_along(methods)) {
rd <- get(paste0("RD_", methods[i]))  # Replace with actual RD values
ci <- get(paste0("ci_", methods[i]))  # Replace with actual CI values
rd_ci <- c(rd, ci)
RD_est <- rbind(RD_est, rd_ci)
}
RD_est$method <- methods_name
colnames(RD_est) <- c("RD", "lower.ci", "upper.ci", "method")
return(RD_est)
}
# Create datasets for each subscript level
RD_no_sub <- create_rd_data(methods_no_sub, methods_name_no_sub)
